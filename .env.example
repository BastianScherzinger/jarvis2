# JARVIS LeadHunter — Konfiguration
# Kopiere zu .env und trage Werte ein.

# KI-Modus (wird beim Start automatisch gesetzt)
# local = nur Ollama | cloud = Claude API | both = parallel
JARVIS_AI_MODE=local

# Anthropic API Key — nur bei cloud/both nötig
ANTHROPIC_KEY=sk-ant-...
# Mehrere "Claudes": weitere Keys eintragen → das System rotiert automatisch auf einen
# freien Key, sobald einer am Session-/Weekly-Limit ist (mehr Durchsatz). Beides geht:
# ANTHROPIC_KEY_2=sk-ant-...
# ANTHROPIC_KEY_3=sk-ant-...
# ODER komma-getrennt:  ANTHROPIC_KEYS=sk-ant-...,sk-ant-...,sk-ant-...

# Lokales Ollama-Modell (mind. 7B für Tool-Use)
JARVIS_TOOL_MODEL=qwen2.5:7b

# Browser sichtbar oder headless
# false = sichtbar (Standard), true = headless (schneller)
JARVIS_BROWSER_HEADLESS=false

# Bewertungs-Modell (überschreibt die Hardware-Empfehlung beim Start)
# JARVIS_EVAL_MODEL=qwen2.5:7b

# Hugging-Face-Token — NUR nötig für gesperrte (gated) Bildmodelle wie FLUX.
# Offene Modelle (Stable Diffusion XL / SD 2.1) brauchen KEINEN Token.
# Für FLUX: huggingface.co/black-forest-labs/FLUX.1-schnell öffnen, Lizenz
# akzeptieren, Token unter huggingface.co/settings/tokens erstellen.
# HF_TOKEN=hf_...

# ── OpenAI (ChatGPT) Hero-Bilder — gpt-image-1 ─────────────────────────────────
# STANDARD-Quelle für Hero-Bilder: hochwertige, fotorealistische Banner aus der
# OpenAI-Cloud, hardware-unabhängig. Ohne Key wird automatisch auf Higgsfield/lokal
# zurückgefallen. Key erstellen: https://platform.openai.com/api-keys
# (Billing/Guthaben am OpenAI-Konto muss aktiv sein.)
# OPENAI_API_KEY=sk-...
# Kostendeckel: max. OpenAI-Bilder pro Tag (Default 30; 0 = OpenAI-Bilder aus).
# JARVIS_OPENAI_IMAGE_DAILY_MAX=30
# Qualität: low | medium | high (Default medium — gute Balance Preis/Qualität).
# JARVIS_OPENAI_IMAGE_QUALITY=medium
# Welche Engine erzeugt Hero-Bilder automatisch (Build + Makeover)?
#   higgsfield (Default — Abo, keine Extra-API-Kosten) | openai | local | auto
# OpenAI bleibt im Medien-Reiter manuell wählbar, ist aber NICHT die Auto-Standardquelle.
# JARVIS_HERO_ENGINE=higgsfield

# ── Medien-Studio (Bilder & Videos) ────────────────────────────────────────────
# Ein Reiter „Medien" mit Modus-Umschalter (Bild/Video). Bild-Engines: ChatGPT (OpenAI,
# s.o.), Lokal (Diffusers), Higgsfield Cloud. Video: Lokal (Wan, nur GPU) oder Higgsfield.
# JARVIS_VIDEO_BACKEND=auto         # auto | local | higgsfield (auto: CPU→Higgsfield)
# JARVIS_MEDIA_DEBUG=0              # 1 = ausführliche Media-/Higgsfield-Logs
# Night-Builder-Resilienz: ist das Claude-Code-Limit leer, nutzt der Builder ChatGPT
# (Hero-Bilder) weiter; sind BEIDE leer, schaltet er ab und startet nach dieser Zeit neu:
# JARVIS_EXHAUST_WAIT=3600         # Sekunden bis zum automatischen Neustart (Default 1 h)

# ── Lead-Generierung (vollständig kostenlos: Browser-Scraper + Ollama) ──────────
# Stufe 1 (Scraper) findet Adresse/Bilder/URL/Daten → leads_raw.db; Stufe 2 (lokale KI/
# Ollama) bewertet + Beschreibung → leads_evaluated.db. KEINE bezahlte API.
# Bewertungs-Threads: Default = CPU-Kerne des PCs (maximale Parallelität).
# JARVIS_EVAL_THREADS=8
# Gleichzeitige Ollama-Calls (schützt das Modell vor Überlast). Auf starker GPU erhöhbar.
# JARVIS_OLLAMA_PARALLEL=2

# ── Cloud-Sync (Supabase) ──────────────────────────────────────────────────────
# Überträgt bewertete Leads nach Supabase → Anzeige auf Railway-Seite.
# SUPABASE_URL  : Projekt-URL  (Supabase Dashboard → Settings → API → URL)
# SUPABASE_SERVICE_KEY : Service-Role-Key (Settings → API → service_role) — GEHEIM!
#                        NUR für den Sync — NIEMALS im Frontend verwenden.
SUPABASE_URL=https://cmuegnwgvmdrtbszrgic.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...

# ── Auto-E-Mail-Versand (Säule 6) ──────────────────────────────────────────────
# Sicherheits-Schalter: solange false = Trockenlauf, es wird NICHTS gesendet.
# Vollständige Anleitung: workspace/TUTORIAL_AUTO_EMAIL.md
JARVIS_EMAIL_ENABLED=false
# SMTP_HOST=smtp.dein-provider.de
# SMTP_PORT=587                       # 587 STARTTLS | 465 SSL
# SMTP_USER=postfach@deine-domain.de
# SMTP_PASS=DEIN_APP_PASSWORT         # GEHEIM — niemals committen, wird nie geloggt
# SMTP_FROM=Dein Name <kontakt@deine-domain.de>
# JARVIS_EMAIL_RATE=20                # max. Mails pro Stunde
# JARVIS_EMAIL_FOOTER=Dein Name · Firma · Anschrift · Abmeldung per Antwort
# Auto-Versand-Loop (optional, siehe Tutorial) — beide Schalter nötig:
# JARVIS_AUTO_MAIL=false
# JARVIS_AUTO_MAIL_MIN_SICHERHEIT=55

# ── Angebotspreis ───────────────────────────────────────────────────────────
# Fairer Komplettpreis in der Angebots-Mail (Default 299 €). Wird automatisch durch den
# bewerteten Tier (potenzial_euro) ersetzt, falls vorhanden.
# JARVIS_OFFER_PRICE=299

# ── Rechtsrahmen / WVM-IT (eigene Firma) ─────────────────────────────────────
# Eigene Firmendaten für Impressum + Signatur der Angebots-Mail UND den „Erstellt von
# WVM-IT"-Credit auf jeder Kundenseite. EINMAL setzen — sonst stehen Platzhalter.
# JARVIS_WVM_NAME=WVM-IT
# JARVIS_WVM_PERSON=Bastian Scherzinger
# JARVIS_WVM_URL=https://wvm-it.at
# JARVIS_WVM_ADDRESS=Straße Nr, PLZ Ort
# JARVIS_WVM_EMAIL=kontakt@wvm-it.at
# JARVIS_WVM_PHONE=
# JARVIS_WVM_VATID=
# Logo/Foto für Kundenseite (Pfad) bzw. Mail (öffentliche URL):
# JARVIS_WVM_LOGO=/static/img/wvm_logo.png
# JARVIS_WVM_PHOTO=/static/img/wvm_bastian.png
# JARVIS_WVM_LOGO_URL=https://wvm-it.at/logo.png
# Abmeldung (UWG/DSGVO): öffentliche Dashboard-URL für den Ein-Klick-Abmelde-Link
# (ohne sie greift der „mit STOP antworten"-Weg). Plus ein Geheimnis für die Link-Token.
# JARVIS_PUBLIC_URL=https://dein-dashboard.example
# JARVIS_UNSUB_SECRET=ein-langes-zufaelliges-geheimnis
# JARVIS_UNSUB_MAILTO=abmelden@wvm-it.at

# ── Hero-Bilder (Higgsfield-Abo schonen) ─────────────────────────────────────
# Max. Cloud-Hero-Bilder pro Tag (≈40-€-Abo-Budget). 0 = unbegrenzt.
# JARVIS_HERO_DAILY_MAX=5
# Higgsfield-Prompt-Enhance (1=an). Für Hero AUS, damit kein Text ins Bild kommt.
# JARVIS_HF_ENHANCE=0

# ── Demo-Abbau (Hosting-Kosten deckeln) ──────────────────────────────────────
# Nicht verkaufte Live-Demos nach so vielen Tagen automatisch abbauen (Railway-Service
# löschen + archivieren). 0 = aus. Verkaufte/Termin-Leads bleiben.
# JARVIS_DEMO_TEARDOWN_DAYS=10

# ── Makeover-Effizienz ───────────────────────────────────────────────────────
# Ein-Pass-Makeover (Standard 1): gesamter Makeover in EINEM Claude-Lauf (günstigste Variante).
# 0 = die 3 getrennten Stufen (Aufbau/Design/QA, mehr Kontrolle, mehr Tokens).
# JARVIS_MAKEOVER_ONEPASS=1
# Lokales Modell für die Content-Generierung (Prosa). Leer = bestes installiertes, GPU-/VRAM-
# bewusst (z.B. qwen2.5:7b/14b auf GPU). Für mehr Qualität ein größeres Modell installieren.
# JARVIS_CONTENT_MODEL=
# Voller 88-KB-taste-Pass statt des kompakten Skills (mehr Tokens, maximale Design-Tiefe):
# JARVIS_MAKEOVER_DESIGN_SKILL=design-taste-frontend
# Update-Level, das auf jeder Seite angezeigt wird:
# JARVIS_SITE_VERSION=1.0

# ── Claude-Dashboard-Agent: Werkzeuge ────────────────────────────────────────
# Maps-Tool nutzt GOOGLE_MAPS_API_KEY (oben). Dafür im Google-Cloud-Projekt die
#   "Places API (New)" aktivieren (für Routen zusätzlich "Routes API").
# Higgsfield-Video-Tool (optional) braucht einen API-Key von cloud.higgsfield.ai:
# HIGGSFIELD_API_KEY=
# JARVIS_CLAUDE_MODEL=claude-opus-4-8   # Modell des Dashboard-Agenten
