# ═══════════════════════════════════════════════════
#  renovierung_firma – Environment Variables
#  Kopiere diese Datei zu .env und fülle die Werte aus
# ═══════════════════════════════════════════════════

# ── Django Core ───────────────────────────────────
SECRET_KEY=django-insecure-replace-this-with-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Datenbank ─────────────────────────────────────
# Neon oder Railway PostgreSQL
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Cloudinary (optional) ─────────────────────────
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# ── E-Mail / Resend ───────────────────────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@deine-domain.de
ADMIN_EMAIL=admin@deine-domain.de

# ── Site-Konfiguration ────────────────────────────
SITE_NAME=Meine Firma
SITE_URL=https://deine-domain.up.railway.app
